apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: restricted-user
  namespace: {{ formatted_github_user_id }}
  labels:
    session: "{{ session_id }}"
rules:
  - apiGroups: [""]
    resources:
      {% for resource in core_allowed_resources %}
      - {{ resource }}
      {% endfor %}
    verbs:
      {% for verb in allowed_verbs %}
      - {{ verb }}
      {% endfor %}

  {% if apps_allowed_resources %}
  - apiGroups: ["apps"]
    resources:
      {% for resource in apps_allowed_resources %}
      - {{ resource }}
      {% endfor %}
    verbs:
      {% for verb in allowed_verbs %}
      - {{ verb }}
      {% endfor %}
  {% endif %}
